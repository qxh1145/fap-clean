{
  "manifest_version": 3,
  "name": "FAP Clean",
  "short_name": "FAP Clean",
  "version": "1.0.0",
  "description": "Giao diện tối giản cho FAP (fap.fpt.edu.vn): trang chủ dạng ô, lịch hôm nay, tìm nhanh Ctrl+K, chế độ tối. Không chính thức.",
  "default_locale": "vi",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://fap.fpt.edu.vn/*"],
  "action": {
    "default_title": "FAP Clean",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://fap.fpt.edu.vn/*"],
      "css": ["styles/fonts.css", "styles/fapx.css"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["https://fap.fpt.edu.vn/*"]
    }
  ]
}
